# Digital Attendance — environment template
# Copy to .env and fill in before production deploy.

FLASK_ENV=production
SECRET_KEY=replace-with-long-random-string

# Public student self-register (keep 0 in production)
ALLOW_PUBLIC_REGISTER=0
# REGISTER_INVITE_CODE=optional-shared-code

# Storage
KEEP_CAPTURE_IMAGES=0
MAX_CAPTURE_IMAGES=48
DATASET_DIR=/data/dataset
DB_PATH=/data/attendance.db

# Optional later: Postgres
# DATABASE_URL=postgresql://attendance:password@db:5432/attendance

# College React portal API (Phase 3)
# Shared secret — portal sends: Authorization: Bearer <key>
PORTAL_API_KEY=replace-with-long-random-portal-key
# Optional: attendance server pushes daily packs to portal webhook
# PORTAL_PUSH_URL=https://college-portal.example/api/attendance/ingest
# PORTAL_PUSH_TOKEN=portal-side-token

SESSION_COOKIE_SECURE=1
MAX_CONTENT_LENGTH_MB=20

GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
