# Digital Attendance — environment template
# Copy to .env  →  cp .env.example .env

FLASK_ENV=development
SECRET_KEY=dev-change-me-before-production

# Public student self-register (keep 0)
ALLOW_PUBLIC_REGISTER=0

# ---- Database (PostgreSQL is permanent) ----
# Postgres.app on this Mac project uses port 5433
DATABASE_URL=postgresql://attendance:attendance@127.0.0.1:5433/attendance

# Emergency only — do NOT set this for normal use:
# USE_SQLITE=1

# Storage
KEEP_CAPTURE_IMAGES=0
MAX_CAPTURE_IMAGES=48
# DATASET_DIR=/data/dataset

SESSION_COOKIE_SECURE=0
MAX_CONTENT_LENGTH_MB=20

GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
