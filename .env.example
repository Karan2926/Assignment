# Digital Attendance — environment template
# Copy to .env and fill in before production deploy.

FLASK_ENV=production
SECRET_KEY=replace-with-long-random-string

# Public student self-register (keep 0 in production)
ALLOW_PUBLIC_REGISTER=0
# REGISTER_INVITE_CODE=optional-shared-code

# Storage
KEEP_CAPTURE_IMAGES=0
MAX_CAPTURE_IMAGES=48
DATASET_DIR=/data/dataset

# Database:
# - Local/dev: leave DATABASE_URL empty → SQLite at DB_PATH
# - College production: set Postgres URL (see POSTGRES.md)
# DATABASE_URL=postgresql://attendance:attendance@127.0.0.1:5432/attendance
DB_PATH=/data/attendance.db
# POSTGRES_PASSWORD=attendance

SESSION_COOKIE_SECURE=1
MAX_CONTENT_LENGTH_MB=20

GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
